@startuml
!pragma layout smetana
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Microsoft YaHei"
hide empty description
state "待处理" as INIT
state "待处理" as S1
state "退款中" as S2
S1 --> S2 : 审核通过并执行 [有权限]
state "成功" as S3
S2 --> S3 : 渠道资金成功 [可信结果]
state "失败" as S4
S2 --> S4 : 渠道明确失败 [可信失败]
S2 --> S2 : 结果未知 [无结论]
S4 --> S2 : 财务重试 [复用原退款任务标识]
@enduml