@startuml
!pragma layout smetana
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Microsoft YaHei"
hide empty description
state "开始" as START
state "同步供应商候选目录" as N1
state "运营选品并补齐内容" as N2
state "人工确认非组合商品白名单" as N3
state "设置零售价" as N4
state "◇ 零售价 ≥ max(供货价, 最低零售价)" as N5
state "标记价格不合规并阻止发布" as N6
state "内容审核并发布" as N7
state "进入首页/搜索/详情可售" as N8
state "供应商下架/价格变化/库存新鲜为 0" as N9
state "停止新购，历史订单仍可查看/重试" as N10
START --> N1
N1 --> N2
N2 --> N3
N3 --> N4
N4 --> N5
N5 --> N6 : 不通过
N6 --> N4 : 调价后重试
N5 --> N7 : 通过
N7 --> N8
N8 --> N9
N9 --> N10
N8 --> [*]
N10 --> [*]
@enduml