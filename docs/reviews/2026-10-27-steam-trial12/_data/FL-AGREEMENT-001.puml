@startuml
!pragma layout smetana
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Microsoft YaHei"
hide empty description
state "开始" as START
state "运营发布新协议版本" as N1
state "◇ 是否标记实质性变更" as N2
state "旧未支付单沿用创建时版本" as N3
state "旧未支付单继续支付前重新确认" as N4
state "新订单一律使用最新版本" as N5
state "未重新确认：阻断继续支付" as N6
state "确认新版本并记录时间" as N7
START --> N1
N1 --> N2
N2 --> N3 : 普通更新
N2 --> N4 : 实质性变更
N3 --> N5
N4 --> N6 : 未确认
N4 --> N7 : 已重新确认
N6 --> N4 : 去确认
N5 --> [*]
N7 --> [*]
@enduml